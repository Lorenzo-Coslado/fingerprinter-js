{
  "name": "fingerprinter-js",
  "version": "3.0.0",
  "description": "Open-source browser fingerprinting for JavaScript and TypeScript: local SHA-256 fingerprints, typed diagnostics, and automation signals.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./collectors": {
      "import": {
        "types": "./dist/collectors.d.ts",
        "default": "./dist/collectors.js"
      },
      "require": {
        "types": "./dist/collectors.d.cts",
        "default": "./dist/collectors.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/API.md",
    "docs/MIGRATION.md",
    "docs/PRIVACY.md",
    "docs/ECOSYSTEM.md",
    "docs/RELEASING.md",
    "docs/assets/pipeline.svg",
    "docs/assets/favicon.svg",
    "docs/DEMO.md",
    "docs/VALIDATION.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "dev": "npm run demo",
    "demo": "npm run build:demo && node scripts/serve-demo.mjs",
    "preview": "node scripts/serve-demo.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs && publint && attw --pack",
    "lint": "eslint src tests scripts *.mjs *.ts docs/app.js",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "prepublishOnly": "npm run check",
    "release:check": "node scripts/release-check.mjs",
    "test:mutation": "node scripts/check-hash-mutation.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "keywords": [
    "browser-fingerprinting",
    "browser-fingerprint",
    "fingerprinting",
    "javascript",
    "typescript",
    "device-fingerprint",
    "browser-identification",
    "browser-signals",
    "canvas-fingerprint",
    "webgl-fingerprint",
    "automation-detection",
    "bot-detection",
    "diagnostics",
    "privacy"
  ],
  "author": "Lorenzo Coslado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lorenzo-Coslado/fingerprinter-js.git"
  },
  "bugs": {
    "url": "https://github.com/Lorenzo-Coslado/fingerprinter-js/issues"
  },
  "homepage": "https://lorenzo-coslado.github.io/fingerprinter-js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Lorenzo-Coslado"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "typesVersions": {
    "*": {
      "collectors": [
        "dist/collectors.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ]
    }
  }
}
